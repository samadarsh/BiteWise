# App configuration
APP_ENV=development
USE_MOCK_MCP=true
SWIGGY_ENV=mock

# Database configuration
DATABASE_URL=sqlite:///./nutriorder.db

# Encrypted session key (32 bytes or 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Swiggy Staging/Production configurations
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com/food
SWIGGY_INSTAMART_MCP_BASE_URL=https://mcp.swiggy.com/im
SWIGGY_TOKEN=
SWIGGY_AUTH_URL=https://mcp.swiggy.com/auth/authorize
SWIGGY_TOKEN_URL=https://mcp.swiggy.com/auth/token
SWIGGY_LOGOUT_URL=https://mcp.swiggy.com/auth/logout
SWIGGY_REGISTER_URL=https://mcp.swiggy.com/auth/register
# Leave SWIGGY_CLIENT_ID/SECRET blank for localhost dev — BiteWise
# self-registers a client_id via Dynamic Client Registration (RFC 7591) the
# first time real (non-mock) OAuth runs, no builders@swiggy.in application
# needed. Only set these once you have a manually-issued production client_id
# from applying at mcp.swiggy.com/builders/access.
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_REDIRECT_URI=http://localhost:8000/auth/swiggy/callback
ALLOW_PLACE_ORDER=false
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# Secret used to HMAC-sign session tokens. Optional: falls back to ENCRYPTION_KEY
# if unset. Set a distinct value in production (any long random string).
SESSION_SECRET=

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Error tracking (optional). Leave blank locally/in CI — unhandled
# exceptions only go to stdout logs until this is set to a real Sentry DSN.
SENTRY_DSN=

# Food image scan (optional). Leave blank to disable — POST
# /coach/scan-food-image returns a clean 503 instead of crashing when unset.
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
